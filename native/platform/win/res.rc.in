#include <winver.h>
1 ICON "army2.ico"
1 24 "app.manifest"
101 RCDATA "@JAR@"
1 VERSIONINFO
FILEVERSION 2,5,0,@BUILD@
PRODUCTVERSION 2,5,0,@BUILD@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "042a04b0"
    BEGIN
      VALUE "CompanyName", "Army250"
      VALUE "FileDescription", "Army2.5.0"
      VALUE "FileVersion", "2.5.0.@BUILD@"
      VALUE "ProductName", "Army2.5.0"
      VALUE "ProductVersion", "2.5.0"
      VALUE "OriginalFilename", "Army250.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x042a, 1200
  END
END
